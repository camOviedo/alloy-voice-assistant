# =====================================================
# Configuración de LLMs para Asistente Híbrido
# =====================================================
# Copia este archivo a .env y configura tus credenciales:
#   cp .env.example .env
#
# Las variables se cargan automáticamente al iniciar el asistente.

# =====================================================
# LLM REMOTO - Para Razonamiento Complejo
# =====================================================
# Este LLM se usa para: análisis, planificación, decisiones arquitectónicas
# Ventaja: Mayor capacidad de razonamiento (GPT-4, Claude, etc.)

# API Key del proveedor (requerida para habilitar LLM remoto)
# Ejemplos:
#   - OpenAI: sk-...
#   - OpenRouter: sk-or-...
#   - Otras APIs compatibles con OpenAI
OPENAI_API_KEY=tu_api_key_aqui

# URL base de la API (opcional, por defecto: https://api.openai.com/v1)
# Ejemplos:
#   - OpenAI: https://api.openai.com/v1
#   - OpenRouter: https://openrouter.ai/api/v1
#   - Local (LM Studio, etc.): http://localhost:1234/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Modelo a usar para razonamiento (opcional, por defecto: gpt-4o)
# Recomendaciones:
#   - OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
#   - OpenRouter: anthropic/claude-3.5-sonnet, google/gemini-pro, etc.
#   - Local: cualquier modelo cargado en LM Studio
REMOTE_LLM_MODEL=gpt-4o

# =====================================================
# LLM LOCAL (Ollama) - Para Generación de Código
# =====================================================
# Este LLM se usa para: aplicar cambios a archivos, tareas mecánicas
# Ventaja: Sin costo, privado, ideal para código repetitivo

# Modelo local en Ollama (debe estar instalado con: ollama pull <modelo>)
# Recomendaciones:
#   - qwen3-vl:8b-extreme (razonamiento + visión)
#   - qwen2.5-coder:14b (especializado en código)
#   - codellama:13b-code (especializado en código)
#   - deepseek-coder-v2:16b (especializado en código)
LOCAL_LLM_MODEL=qwen3-vl:8b-extreme

# =====================================================
# EJEMPLOS DE CONFIGURACIÓN POR PROVEEDOR
# =====================================================

# --- OpenAI (por defecto) ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# REMOTE_LLM_MODEL=gpt-4o

# --- OpenRouter (acceso a múltiples modelos) ---
# OPENAI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# REMOTE_LLM_MODEL=anthropic/claude-3.5-sonnet

# --- LM Studio (modelo local vía API OpenAI) ---
# OPENAI_API_KEY=lm-studio
# OPENAI_BASE_URL=http://localhost:1234/v1
# REMOTE_LLM_MODEL=modelo-cargado-en-lm-studio

# =====================================================
# NOTAS IMPORTANTES
# =====================================================
# 1. Si no configuras OPENAI_API_KEY, el sistema funcionará
#    solo con LLM local (Ollama) sin modo híbrido.
#
# 2. El LLM remoto NUNCA verá tus archivos locales directamente,
#    solo recibe análisis/descripciones del LLM local.
#
# 3. Los cambios a archivos SIEMPRE los aplica el LLM local
#    (privacidad y costo cero para operaciones mecánicas).
#
# 4. Para habilitar visión en el LLM remoto, usa modelos
#    multimodales como gpt-4o o claude-3.5-sonnet.
#
# 5. Reinicia el asistente después de modificar este archivo.
